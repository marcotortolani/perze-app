        "selector": "JSXOpeningElement[name.name='BudgetRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|size|stroke|label|sublabel|style|key|ref|className|style|children)$/]",
        "message": "<BudgetRing> doesn't accept that prop. Declared props: progress, size, stroke, label, sublabel, style."
