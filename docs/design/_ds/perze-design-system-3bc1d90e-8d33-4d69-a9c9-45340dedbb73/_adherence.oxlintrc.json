{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/feedback/**",
              "components/finance/**",
              "components/money/**",
              "components/nav/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|institution|name|balance|currency|country|key|ref|className|style|children)$/]",
        "message": "<AccountSummary> doesn't accept that prop. Declared props: id, institution, name, balance, currency, country."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|size|polarity|showSign|showArrow|tabular|mutedDecimals|decimals|privacy|style|key|ref|className|style|children)$/]",
        "message": "<Amount> doesn't accept that prop. Declared props: value, currency, size, polarity, showSign, showArrow, tabular, mutedDecimals, decimals, privacy, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero-xl|hero|title|body|label)$/]",
        "message": "<Amount> size must be one of 'hero-xl' | 'hero' | 'title' | 'body' | 'label'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='polarity'] > Literal[value!=/^(?:positive|negative|negative-emphasis|neutral)$/]",
        "message": "<Amount> polarity must be one of 'positive' | 'negative' | 'negative-emphasis' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountScrubber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|step|onChange|onOpenKeypad|style|key|ref|className|style|children)$/]",
        "message": "<AmountScrubber> doesn't accept that prop. Declared props: value, currency, step, onChange, onOpenKeypad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|scope|onScopeChange|scopeOptions|onSearch|onBack|syncState|pending|showScope|right|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, scope, onScopeChange, scopeOptions, onSearch, onBack, syncState, pending, showScope, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='syncState'] > Literal[value!=/^(?:synced|syncing|offline)$/]",
        "message": "<AppHeader> syncState must be one of 'synced' | 'syncing' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|display|key|ref|className|style|children)$/]",
        "message": "<BarDatum> doesn't accept that prop. Declared props: label, value, color, display."
