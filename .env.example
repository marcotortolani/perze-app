# Copiá este archivo a .env.local y completá los valores. Ninguno de estos
# es secreto de servidor salvo donde se indica — la publishable/anon key de
# Supabase es segura para el bundle del cliente, la barrera real es RLS.

# Proyecto de Supabase (Settings → API en el dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio público de tu deploy — para metadataBase (og:image, splash de PWA).
# Opcional en dev, cae a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# K12 — Web Push. Generá tu propio par de claves VAPID (ver docs/self-hosting.md
# § Notificaciones push) — la privada NUNCA va acá, solo en el secret de la
# Edge Function `send-push` (`supabase secrets set VAPID_PRIVATE_KEY=...`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# CSV de "google"/"apple" — cuáles OAuth providers ya registraste en
# Supabase Auth (dashboard → Authentication → Providers). Vacío o sin
# definir: sin OAuth, el email es el campo primario del login y los
# botones de Google/Apple no se dibujan (CLAUDE.md § "Orden de A2").
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google,apple

# Solo si vas a correr migraciones/generar tipos con el CLI de Supabase desde
# esta máquina (no lo necesita el runtime de la app) — Settings → Access Tokens.
# SUPABASE_ACCESS_TOKEN=

# Resend — mails que manda la propia app (hoy: invitación al household, J3).
# Secreto de servidor, NUNCA `NEXT_PUBLIC_*`: se lee solo en Route Handlers
# (src/app/api/emails/invite/route.ts), nunca llega al bundle del cliente.
# Sin esto, ese route handler responde 503 y la UI cae al camino de copiar
# el código a mano — un self-host sin Resend no se rompe.
# RESEND_API_KEY=
# EMAIL_FROM=invitaciones@tu-dominio.com

# El service worker no se registra en `next dev`: con Turbopack los chunks
# cambian de nombre en cada arranque y el precache de la sesión anterior
# deja la app en blanco, sin error en consola. Poné "1" solo para probar
# offline o la instalación de la PWA en local — y acordate de limpiar el
# service worker desde DevTools cuando termines.
# NEXT_PUBLIC_ENABLE_SW_IN_DEV=1
